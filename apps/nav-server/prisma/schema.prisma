generator client {
  provider = "prisma-client-js"
}

generator typeGen {
  provider = "prisma-client" // Required
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model NavLink {
  id          Int      @id @default(autoincrement())
  categoryId  String
  name        String
  // 网站url
  href        String
  desc        String
  logo        String
  authorName  String
  authorUrl   String
  auditTime   DateTime @default(now())
  createTime  DateTime @default(now())
  tag         NavTag[]
  // 页面浏览次数
  view        Int      @default(0)
  star        Int      @default(0)
  // 审核状态 1 审核中 2 拒绝 3 通过
  status      LinkState
  // 访问状态 1 正常访问 2 需要代理 3 网站已停用
  accessState LinkAccessState
}

enum LinkState {
  CHECK
  REJECT
  PASS
}

enum LinkAccessState {
  NORMAL
  PROXY
  DEACTIVATE
}

model NavTag {
  id         Int       @id @default(autoincrement())
  name       String
  createTime DateTime
  NavLink    NavLink[]
}

model NavCategory {
  id         Int      @id @default(autoincrement())
  name       String
  createTime DateTime
  icon       String
  parentId   Int
}

model UserFeedback {
  id          Int      @id @default(autoincrement())
  programName String // 项目名称
  type        String // feature 建议 | error 错误 | suggest 建议 
  title       String // 错误标题
  describe    String // 用户输入的详情描述
  images      String[] // 用户的截图
  isHandled   Boolean  @default(false)
  // time        String
  // handledTime DateTime @default(now())// 处理时间
  // reportTime  DateTime @default(now())// 提交时间
  reportUser  String // 提交用户
  deviceName  String // 设备信息
}

model UserTrack {
  id           Int    @id @map("_id")
  programName  String
  errorContent String
}

model User {
  id   Int    @id @default(autoincrement())
  name String
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_MONGO_URL")
}

model Post {
  // id        Int      @id @default(auto()) @map("_id") @db.ObjectId
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String?
  published Boolean  @default(false)
  viewCount Int      @default(0)
  authorId  Int?
  userEmail String?
}

model UserFeedback {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  programName String // 项目名称
  type        String // feature 建议 | error 错误 | suggest 建议 
  title       String // 错误标题
  describe    String // 用户输入的详情描述
  images      String[] // 用户的截图
  isHandled   Boolean  @default(false)
  // time        String
  // handledTime DateTime @default(now())// 处理时间
  // reportTime  DateTime @default(now())// 提交时间
  reportUser  String // 提交用户
  deviceName  String // 设备信息
}

model UserTrack {
  id          Int    @id @map("_id")
  programName String
}

model AppVersion {
  id          Int    @id @map("_id")
  programName String
  version     String
}

{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "target": "ES2020",
    "strict": true,
    "module": "ES2020",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@P/*": [
        "../*"
      ]
    },
  },
  "vueCompilerOptions": {
    "target": 3.5
  }
}